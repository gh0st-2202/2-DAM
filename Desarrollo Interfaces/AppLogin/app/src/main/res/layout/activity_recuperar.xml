<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_menu_help"
            android:contentDescription="@string/cd_recuperar"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recuperar_titulo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etUsuarioRecuperar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/usuario_hint"
            android:inputType="textPersonName"
            android:autofillHints="username"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnRecuperarClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buscar_password" />

        <TextView
            android:id="@+id/tvResultadoRecuperar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/llCambioPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cambiar_password_prompt"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNuevaPasswordRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/nueva_password"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etRepetirPasswordRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/repetir_nueva_password"
                android:inputType="textPassword"
                android:autofillHints="newPassword"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnCambiarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cambiar_password" />

        </LinearLayout>

        <Button
            android:id="@+id/btnVolverRecuperar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/volver_login" />

    </LinearLayout>
</ScrollView>